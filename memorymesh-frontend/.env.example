# Copy to .env.local. Placeholders only — never put secrets in VITE_* variables;
# they are bundled into the browser build.

# Base URL of the MemoryMesh FastAPI backend (used only in API mode).
VITE_API_BASE_URL=http://localhost:8000

# Starting mode: "demo" (default, deterministic mock data) or "api" (real HTTP calls).
# Users can also switch in /app/settings.
VITE_DEFAULT_MODE=demo

# Default tenant id sent as tenant_id on every backend call.
VITE_DEFAULT_TENANT_ID=demo-tenant
